{
  "name": "late_fill_after_cancel",
  "description": "Phase 1 paper env: a fill arriving after the order has been cancelled must apply via terminal_fill_correction (Cancelled -> Filled), not silently drop.",
  "market_id": "btc-5m",
  "starting_cash_usd": 200.0,
  "event_log_capacity": 128,
  "paper_mode": false,
  "adapter": {
    "submit": [
      { "outcome": "accepted", "client_order_id": "late-fill-1", "venue_order_id": "venue-late-fill-1" }
    ]
  },
  "events": [
    {
      "type": "snapshot",
      "at_ms": 1000,
      "instrument_id": "up-token",
      "market_id": "btc-5m",
      "best_bid": { "price": 0.42, "quantity": 100.0 },
      "best_ask": { "price": 0.44, "quantity": 100.0 },
      "last_trade_price": 0.43,
      "decisions": [
        {
          "client_order_id": "late-fill-1",
          "instrument_id": "up-token",
          "side": "Buy",
          "limit_price": 0.42,
          "quantity": 10.0,
          "reduce_only": false,
          "reason": "passive-buy"
        }
      ]
    },
    {
      "type": "cancel",
      "at_ms": 1100,
      "client_order_id": "late-fill-1",
      "reason": "operator cancel"
    },
    {
      "type": "fill",
      "at_ms": 1150,
      "client_order_id": "late-fill-1",
      "market_id": "btc-5m",
      "instrument_id": "up-token",
      "side": "Buy",
      "price": 0.42,
      "quantity": 10.0,
      "fee_usd": 0.0,
      "liquidity": "Maker"
    },
    {
      "type": "checkpoint",
      "at_ms": 1200,
      "label": "post-late-fill",
      "expected": {
        "runtime_status": "Running",
        "open_orders": [],
        "inventory": {}
      }
    }
  ],
  "expected": {
    "runtime_status": "Running",
    "free_cash_usd": 195.8,
    "open_order_count": 0,
    "required_checkpoint_keys": ["checkpoint_id", "run_id", "created_at_ms", "runtime_status", "inventory_json", "open_orders_json", "pair_state_json"],
    "required_event_categories": ["Runtime", "Strategy", "Execution", "Inventory", "Risk"]
  }
}
