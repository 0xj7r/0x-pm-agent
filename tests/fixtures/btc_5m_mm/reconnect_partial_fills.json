{
  "name": "reconnect_partial_fills",
  "description": "partial fills after reconnect should preserve running checkpoint and reconcile state",
  "market_id": "btc-5m",
  "starting_cash_usd": 100.0,
  "event_log_capacity": 256,
  "paper_mode": false,
  "adapter": {
    "submit": [
      { "outcome": "accepted", "client_order_id": "reconnect-1", "venue_order_id": "venue-reconnect-1" }
    ],
    "sync_open_orders": {
      "open_orders": [
        {
          "client_order_id": "reconnect-1",
          "venue_order_id": "venue-reconnect-1",
          "market_id": "btc-5m",
          "instrument_id": "up-token",
          "side": "Buy",
          "limit_price": 0.90,
          "original_qty": 10.0,
          "remaining_qty": 7.0,
          "created_at_ms": 5000
        }
      ]
    }
  },
  "events": [
    {
      "type": "snapshot",
      "at_ms": 5000,
      "instrument_id": "up-token",
      "market_id": "btc-5m",
      "best_bid": { "price": 0.89, "quantity": 25.0 },
      "best_ask": { "price": 0.90, "quantity": 25.0 },
      "last_trade_price": 0.89,
      "decisions": [
        {
          "client_order_id": "reconnect-1",
          "instrument_id": "up-token",
          "side": "Buy",
          "limit_price": 0.90,
          "quantity": 10.0,
          "reduce_only": false,
          "reason": "partial-fill-before-crash"
        }
      ]
    },
    {
      "type": "fill",
      "at_ms": 5012,
      "client_order_id": "reconnect-1",
      "market_id": "btc-5m",
      "instrument_id": "up-token",
      "side": "Buy",
      "price": 0.90,
      "quantity": 3.0,
      "fee_usd": 0.0,
      "liquidity": "Maker"
    },
    {
      "type": "crash",
      "at_ms": 5015,
      "label": "crash-mid-submit"
    },
    {
      "type": "restart",
      "at_ms": 5016,
      "starting_cash_usd": 97.0
    },
    {
      "type": "reconcile",
      "at_ms": 5020,
      "label": "post-reconnect-reconcile",
      "expected": {
        "venue_only": ["reconnect-1"],
        "local_only": [],
        "needs_reconcile": ["reconnect-1"]
      }
    },
    {
      "type": "checkpoint",
      "at_ms": 5025,
      "label": "post-restart",
      "expected": {
        "runtime_status": "Running",
        "inventory": {
          "free_cash_usd": 97.0
        },
        "open_orders": []
      }
    }
  ],
  "expected": {
    "runtime_status": "Running",
    "free_cash_usd": 97.0,
    "open_order_count": 0,
    "required_checkpoint_keys": ["checkpoint_id", "run_id", "created_at_ms", "runtime_status", "inventory_json", "open_orders_json", "pair_state_json"],
    "required_event_categories": ["Runtime", "Strategy", "Execution", "Inventory", "Risk"]
  }
}
