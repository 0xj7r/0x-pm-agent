{
  "name": "stale_book",
  "description": "stale quote snapshots are ignored until refresh is fresh",
  "market_id": "btc-5m",
  "starting_cash_usd": 500.0,
  "event_log_capacity": 128,
  "paper_mode": false,
  "adapter": {
    "submit": [
      { "outcome": "accepted", "client_order_id": "stale-live", "venue_order_id": "venue-stale" }
    ]
  },
  "events": [
    {
      "type": "snapshot",
      "at_ms": 3000,
      "instrument_id": "up-token",
      "market_id": "btc-5m",
      "best_bid": { "price": 0.60, "quantity": 40.0 },
      "best_ask": { "price": 0.62, "quantity": 40.0 },
      "last_trade_price": 0.61,
      "decisions": [
        {
          "client_order_id": "stale-live",
          "instrument_id": "up-token",
          "side": "Buy",
          "limit_price": 0.62,
          "quantity": 10.0,
          "reduce_only": false,
          "reason": "stale-signal"
        }
      ],
      "skip_if_stale": true
    },
    {
      "type": "snapshot",
      "at_ms": 3010,
      "instrument_id": "up-token",
      "market_id": "btc-5m",
      "best_bid": { "price": 0.61, "quantity": 42.0 },
      "best_ask": { "price": 0.63, "quantity": 42.0 },
      "last_trade_price": 0.62,
      "decisions": [
        {
          "client_order_id": "stale-live",
          "instrument_id": "up-token",
          "side": "Buy",
          "limit_price": 0.63,
          "quantity": 10.0,
          "reduce_only": false,
          "reason": "fresh-after-stale"
        }
      ]
    },
    {
      "type": "fill",
      "at_ms": 3012,
      "client_order_id": "stale-live",
      "market_id": "btc-5m",
      "instrument_id": "up-token",
      "side": "Buy",
      "price": 0.63,
      "quantity": 10.0,
      "fee_usd": 0.0,
      "liquidity": "Taker"
    },
    {
      "type": "checkpoint",
      "at_ms": 3015,
      "label": "stale-cleanup",
      "expected": {
        "runtime_status": "Running",
        "inventory": {
          "free_cash_usd": 493.7
        }
      }
    }
  ],
  "expected": {
    "runtime_status": "Running",
    "free_cash_usd": 493.7,
    "open_order_count": 0,
    "required_checkpoint_keys": ["checkpoint_id", "run_id", "created_at_ms", "runtime_status", "inventory_json", "open_orders_json", "pair_state_json"],
    "required_event_categories": ["Runtime", "Strategy", "Execution", "Inventory", "Risk"]
  }
}
