{
  "name": "paper_market_close_with_redeem",
  "description": "Phase 1 paper env: when the runtime crosses paper_market_close_at_ms, plan_paper_close cancels open orders and emits synthetic redeem fills for stranded inventory at the configured resolution price.",
  "market_id": "btc-5m",
  "starting_cash_usd": 200.0,
  "event_log_capacity": 128,
  "paper_mode": false,
  "adapter": {
    "submit": [
      { "outcome": "accepted", "client_order_id": "close-1", "venue_order_id": "venue-close-1" }
    ]
  },
  "events": [
    {
      "type": "snapshot",
      "at_ms": 1000,
      "instrument_id": "up-token",
      "market_id": "btc-5m",
      "best_bid": { "price": 0.55, "quantity": 100.0 },
      "best_ask": { "price": 0.57, "quantity": 100.0 },
      "last_trade_price": 0.56,
      "decisions": [
        {
          "client_order_id": "close-1",
          "instrument_id": "up-token",
          "side": "Buy",
          "limit_price": 0.57,
          "quantity": 5.0,
          "reduce_only": false,
          "reason": "stranded-buy-pre-close"
        }
      ]
    },
    {
      "type": "fill",
      "at_ms": 1050,
      "client_order_id": "close-1",
      "market_id": "btc-5m",
      "instrument_id": "up-token",
      "side": "Buy",
      "price": 0.57,
      "quantity": 5.0,
      "fee_usd": 0.0,
      "liquidity": "Taker"
    },
    {
      "type": "checkpoint",
      "at_ms": 1100,
      "label": "pre-close",
      "expected": {
        "runtime_status": "Running",
        "inventory": {}
      }
    },
    {
      "type": "paper_market_close",
      "at_ms": 2000,
      "resolution_price": 1.0
    },
    {
      "type": "checkpoint",
      "at_ms": 2100,
      "label": "post-close",
      "expected": {
        "runtime_status": "Running",
        "open_orders": [],
        "inventory": {}
      }
    }
  ],
  "expected": {
    "runtime_status": "Running",
    "free_cash_usd": 197.15,
    "open_order_count": 0,
    "required_checkpoint_keys": ["checkpoint_id", "run_id", "created_at_ms", "runtime_status", "inventory_json", "open_orders_json", "pair_state_json"],
    "required_event_categories": ["Runtime", "Strategy", "Execution", "Inventory", "Risk"]
  }
}
