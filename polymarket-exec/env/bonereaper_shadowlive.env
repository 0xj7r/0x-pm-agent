# Shadow-live preset for the bonereaper strategy.
#
# Connects live market WS + spot WS, runs the bonereaper decisioning loop
# (breadth-first paired BUY mid-tracker), and routes every submit through
# the paper adapter so no capital is exposed. Intent is to validate
# concurrent multi-family discovery + maker bid placement before any
# live capital is committed.
#
# Usage:
#   set -a; source polymarket-exec/env/bonereaper_shadowlive.env; set +a
#   cargo run -p polymarket-exec
#
# Safety: WHALE_PAIR_EXEC_MODE=shadow_live forces paper_mode=true at the
# binary entry point regardless of WHALE_PAIR_PAPER_MODE.

WHALE_PAIR_EXEC_MODE=shadow_live
WHALE_PAIR_PAPER_MODE=true
WHALE_PAIR_STRATEGY=bonereaper
WHALE_PAIR_EXEC_STARTING_CASH_USD=2000
WHALE_PAIR_EXEC_MAX_SESSION_LOSS_BPS=500

# Open-order caps scaled for breadth-first operation. Bonereaper sweeps
# 4-5 market families × ~10 active markets each × 2 legs ≈ 100 desired
# quotes concurrently. These caps keep the runtime from refusing legitimate
# entries while phase 1 is verifying the discovery + reconcile path.
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_TOTAL=200
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_PER_MARKET=2

# Multi-family discovery: BTC/ETH 5m + BTC/ETH 15m + BTC 4h.
# Each entry is `slug-prefix:window_ms`.
WHALE_PAIR_MARKET_DISCOVERY_ENABLED=true
WHALE_PAIR_MARKET_DISCOVERY_INTERVAL_MS=30000
WHALE_PAIR_MARKET_DISCOVERY_FAMILIES=btc-updown-5m-:300000,eth-updown-5m-:300000,btc-updown-15m-:900000,eth-updown-15m-:900000,btc-updown-4h-:14400000
WHALE_PAIR_MARKET_DISCOVERY_INCLUDE_PREV=0
WHALE_PAIR_MARKET_DISCOVERY_INCLUDE_NEXT=12

# Quote churn budget. Bonereaper has no per-market cooldown by design;
# the cancel-replace-on-mid-drift cadence is what produces the "bid walks
# with mid" fill profile. We give it a generous churn budget to avoid
# starving the reconciler.
WHALE_PAIR_QUOTE_MIN_ORDER_AGE_MS=250
WHALE_PAIR_QUOTE_MAX_SUBMIT_PER_WINDOW=400
WHALE_PAIR_QUOTE_MAX_REPLACE_PER_WINDOW=400
WHALE_PAIR_QUOTE_MAX_CANCEL_PER_WINDOW=400
WHALE_PAIR_QUOTE_MAX_CHURN_PER_WINDOW=800

# Bonereaper-specific knobs (only sizing + venue defaults; no pricing
# knobs, that's the whole point of the strategy).
WHALE_PAIR_BONEREAPER_CLIP_USD=20
WHALE_PAIR_BONEREAPER_MIN_QTY=5
WHALE_PAIR_BONEREAPER_DEFAULT_TICK=0.01
WHALE_PAIR_BONEREAPER_MAX_CONCURRENT_MARKETS=100

# Live data sources.
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
POLYMARKET_SPOT_SYMBOL=BTCUSDT
POLYMARKET_CLOB_VERSION=v2

# Paper-env conservative defaults. Phase 1 verifies discovery + reconcile;
# phase 2 will add maker rebate accounting on top.
WHALE_PAIR_PAPER_SUBMIT_LATENCY_MS=150
WHALE_PAIR_PAPER_QUEUE_DEPTH_FRACTION=0.75
WHALE_PAIR_PAPER_POST_ONLY_REJECT_PROBABILITY=0.85
WHALE_PAIR_PAPER_CANCEL_RACE_WINDOW_MS=500

WHALE_PAIR_PAPER_REPORT_PATH=polymarket-exec/data/execution/paper/shadow_live_bonereaper/paper_report.json

# Journal + book snapshot streams. The bonereaper_exec_compare.py
# comparator joins against both: book_snapshot gives the venue state at
# bonereaper's fill time, journal gives our strategy's intent emissions
# and order state transitions for the same instant.
WHALE_PAIR_EXEC_JOURNAL_PATH=polymarket-exec/data/execution/paper/shadow_live_bonereaper/journal.jsonl
WHALE_PAIR_BOOK_SNAPSHOT_LOG_PATH=polymarket-exec/data/execution/paper/shadow_live_bonereaper/book_snapshots.jsonl
WHALE_PAIR_BOOK_SNAPSHOT_MAX_LEVELS=5

WHALE_PAIR_LIVE_KILL_SWITCH_PATH=~/.config/polymarket-exec/live.kill
