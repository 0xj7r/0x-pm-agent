# Shadow-live preset — paper-mode mirror of the canonical tinylive env.
#
# Connects live market WS + spot WS for real book/spot data, runs the
# strategy decisioning loop, but routes every submit through the paper
# adapter so no capital is exposed.
#
# DESIGN PRINCIPLE: every WHALE_PAIR_BTC_5M_MM_* and gating knob below
# MUST match btc_5m_mm_tinylive.env exactly. The point of shadow-live is to
# replicate tinylive's strategy decisions on the same live market data,
# so we can A/B test changes here before promoting to live. Any divergence
# in strategy tuning between this file and the live launcher means the
# shadow signal doesn't tell us anything about live behavior.
#
# Only THESE diverge from live (justified):
#   - WHALE_PAIR_PAPER_MODE=true (the whole point)
#   - WHALE_PAIR_EXEC_STARTING_CASH_USD (larger for stress test)
#   - WHALE_PAIR_EXEC_MAX_SESSION_LOSS_BPS (looser for stress)
#   - Order/notional caps (per-market and total — larger to allow more
#     concurrent fills for statistical significance, but proportionally
#     scaled to STARTING_CASH so the relative pressure matches live)
#   - WHALE_PAIR_PAPER_* knobs (paper fill model — only meaningful here)
#
# Usage:
#   set -a; source polymarket-exec/env/btc_5m_mm_shadowlive.env; set +a
#   target/release/polymarket-exec
#
# Safety: WHALE_PAIR_EXEC_MODE=shadow_live forces paper_mode=true at the
# binary entry point regardless of WHALE_PAIR_PAPER_MODE. Even if these
# are misconfigured, no live order can leave the engine.

WHALE_PAIR_EXEC_MODE=shadow_live
WHALE_PAIR_PAPER_MODE=true
WHALE_PAIR_STRATEGY=btc_5m_mm

# Capital + risk caps (DIVERGE from live by design — stress test scale)
WHALE_PAIR_EXEC_STARTING_CASH_USD=1000
WHALE_PAIR_EXEC_MAX_SESSION_LOSS_BPS=2500
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_TOTAL=8
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_PER_MARKET=8

# Market discovery (MIRROR live)
WHALE_PAIR_MARKET_DISCOVERY_ENABLED=true
WHALE_PAIR_MARKET_DISCOVERY_INTERVAL_MS=30000
WHALE_PAIR_MARKET_DISCOVERY_INCLUDE_PREV=0
WHALE_PAIR_MARKET_DISCOVERY_INCLUDE_NEXT=0

# Quote refresh / churn budget (MIRROR live)
# QUOTE_MIN_ORDER_AGE_MS=2000 means a posted quote must rest 2s before
# we cancel/replace it. Shadow-live previously had 250ms which made it
# 8x more aggressive — a totally different fill profile. Match live.
WHALE_PAIR_QUOTE_MIN_ORDER_AGE_MS=2000
WHALE_PAIR_QUOTE_MAX_SUBMIT_PER_WINDOW=60
WHALE_PAIR_QUOTE_MAX_REPLACE_PER_WINDOW=40
WHALE_PAIR_QUOTE_MAX_CANCEL_PER_WINDOW=80
WHALE_PAIR_QUOTE_MAX_CHURN_PER_WINDOW=120

# Strategy: every WHALE_PAIR_BTC_5M_MM_* below MIRRORS btc_5m_mm_tinylive.env.
# When the canonical tinylive env changes one of these, this file must follow.
WHALE_PAIR_BTC_5M_MM_BASE_CLIP_USD=1.10
WHALE_PAIR_BTC_5M_MM_MIN_CLIP_USD=0.25
WHALE_PAIR_BTC_5M_MM_MAX_CLIP_USD=8.0
WHALE_PAIR_BTC_5M_MM_LIQUIDITY_CLIP_FRACTION=0.02
WHALE_PAIR_BTC_5M_MM_MIN_EDGE_BPS=25
WHALE_PAIR_BTC_5M_MM_HEDGE_RESCUE_CLIP_USD=5.00
WHALE_PAIR_BTC_5M_MM_MAX_ENTRY_FREE_CASH_BPS=6000
WHALE_PAIR_BTC_5M_MM_MAX_RESCUE_FREE_CASH_BPS=5000
WHALE_PAIR_BTC_5M_MM_HEDGE_RESCUE_EDGE_BPS=10
WHALE_PAIR_BTC_5M_MM_ENTRY_LADDER_LEVELS=3
WHALE_PAIR_BTC_5M_MM_ENTRY_LADDER_SPACING_TICKS=1
WHALE_PAIR_BTC_5M_MM_COOLDOWN_MS=100
WHALE_PAIR_BTC_5M_MM_ORDER_FLOW_IMBALANCE_THRESHOLD=0.60
WHALE_PAIR_BTC_5M_MM_MOMENTUM_TILT_PER_BPS=0.0005
WHALE_PAIR_BTC_5M_MM_MOMENTUM_MAX_TILT=0.06

# Reconcile + auto-redeem (MIRROR live; auto-redeem doesn't fire in paper
# but keeping the knobs so the runtime initialization path is identical)
WHALE_PAIR_ORDER_RECONCILE_INTERVAL_MS=3000
WHALE_PAIR_LIVE_AUTO_REDEEM=true
WHALE_PAIR_LIVE_AUTO_REDEEM_PERIOD_SEC=300

# Live data sources (MIRROR live)
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
POLYMARKET_SPOT_SYMBOL=BTCUSDT
POLYMARKET_CLOB_VERSION=v2

# Paper-env fill model (DIVERGE — only meaningful here).
# These are the calibration target: tune toward matching observed
# tinylive fill rates over rolling windows.
WHALE_PAIR_PAPER_SUBMIT_LATENCY_MS=150
WHALE_PAIR_PAPER_QUEUE_DEPTH_FRACTION=0.75
WHALE_PAIR_PAPER_POST_ONLY_REJECT_PROBABILITY=0.85
WHALE_PAIR_PAPER_CANCEL_RACE_WINDOW_MS=500

# Decision log (Phase 3): same path schema as tinylive so the comparison
# tool can join by (market_id, timestamp_window).
WHALE_PAIR_PAPER_REPORT_PATH=polymarket-exec/data/execution/paper/shadow_live/paper_report.json

# Operational defaults inherited from common.env / .env.
WHALE_PAIR_LIVE_KILL_SWITCH_PATH=~/.config/polymarket-exec/live.kill
