# Phase 4 paper-env: shadow-live preset.
# Connects live market WS + spot WS for real book/spot data, runs the
# strategy decisioning loop, but routes every submit through the paper
# adapter so no capital is exposed. Operators use this to validate
# strategy behavior end-to-end against the real venue without trading.
#
# Usage:
#   set -a; source polymarket-exec/env/btc_5m_mm_shadowlive.env; set +a
#   cargo run -p polymarket-exec
#
# Safety: WHALE_PAIR_EXEC_MODE=shadow_live forces paper_mode=true at the
# binary entry point regardless of WHALE_PAIR_PAPER_MODE. Even if these
# are misconfigured, no live order can leave the engine.

WHALE_PAIR_EXEC_MODE=shadow_live
WHALE_PAIR_PAPER_MODE=true
WHALE_PAIR_STRATEGY=unlawful_shear

# Live data sources (default Polymarket public endpoints; override per env).
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
POLYMARKET_SPOT_SYMBOL=BTCUSDT

# CLOB V2 cutover (2026-04-28); shadow-live verifies signing path
# without submitting. The startup log in live_auth.rs prints the V2
# exchange address + signature_type for operator verification.
POLYMARKET_CLOB_VERSION=v2

# Paper-env conservative defaults (Phase 2). Override per session if
# you want to stress-test specific behaviors.
WHALE_PAIR_PAPER_SUBMIT_LATENCY_MS=150
WHALE_PAIR_PAPER_QUEUE_DEPTH_FRACTION=0.75
WHALE_PAIR_PAPER_POST_ONLY_REJECT_PROBABILITY=0.85
WHALE_PAIR_PAPER_CANCEL_RACE_WINDOW_MS=500

# Phase 3 paper report: write the per-session JSON summary on shutdown.
WHALE_PAIR_PAPER_REPORT_PATH=polymarket-exec/data/execution/paper/shadow_live/paper_report.json

# Operational defaults inherited from common.env / .env. Override only
# if necessary. The kill-switch path below is harmless in shadow-live
# (paper adapter ignores it) but keeps the operational interface
# consistent with live mode.
WHALE_PAIR_LIVE_KILL_SWITCH_PATH=~/.config/polymarket-exec/live.kill
