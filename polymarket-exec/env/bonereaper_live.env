# Live preset for the bonereaper strategy at micro-capital.
#
# Connects live market WS + spot WS, runs the bonereaper decisioning
# loop, and submits real orders to the venue. Designed for the AWS
# Dublin bot which has VPN access to Polymarket.
#
# Capital exposure is bounded by:
#   - WHALE_PAIR_BONEREAPER_CLIP_USD ($5/clip below)
#   - WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_TOTAL (50 below) -> at most $250
#     in standing entry exposure across all markets
#   - WHALE_PAIR_EXEC_MAX_POSITION_QTY_PER_INSTRUMENT (50 below) ->
#     at most ~$25 worst-case accumulated inventory per instrument
#
# Usage on the AWS box:
#   set -a; source polymarket-exec/env/bonereaper_live.env; set +a
#   /opt/polymarket/bin/polymarket-exec
#
# Safety: the live deploy gate in runtime/fidelity.rs reads the shadow
# process's journal for a recent OK verdict before allowing strategy
# entries. If shadow is silent or has emitted a Fail verdict in the last
# 24h, this process gates to RuntimeStatus::RiskOff and emits no intents.

WHALE_PAIR_EXEC_MODE=live
WHALE_PAIR_PAPER_MODE=false
WHALE_PAIR_STRATEGY=bonereaper
WHALE_PAIR_EXEC_STARTING_CASH_USD=500
WHALE_PAIR_EXEC_MAX_SESSION_LOSS_BPS=2000

# Tight caps for micro-capital live. 50 standing orders × $5 = $250 max
# entry exposure. Tightened from shadow's 200 because real capital is
# at risk.
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_TOTAL=50
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_PER_MARKET=2

# Per-instrument inventory cap. 50 units × ~$0.50 = ~$25 worst-case per
# market. Bonereaper holds to resolution; accumulation past this cap
# means the strategy is misbehaving (cancel-replace loop accumulating).
WHALE_PAIR_EXEC_MAX_POSITION_QTY_PER_INSTRUMENT=50

# Multi-family discovery: same as shadow.
WHALE_PAIR_MARKET_DISCOVERY_ENABLED=true
WHALE_PAIR_MARKET_DISCOVERY_INTERVAL_MS=30000
WHALE_PAIR_MARKET_DISCOVERY_FAMILIES=btc-updown-5m-:300000,eth-updown-5m-:300000,btc-updown-15m-:900000,eth-updown-15m-:900000,btc-updown-4h-:14400000
WHALE_PAIR_MARKET_DISCOVERY_INCLUDE_PREV=0
WHALE_PAIR_MARKET_DISCOVERY_INCLUDE_NEXT=12

# Quote churn budget: same as shadow (bonereaper's design).
WHALE_PAIR_QUOTE_MIN_ORDER_AGE_MS=250
WHALE_PAIR_QUOTE_MAX_SUBMIT_PER_WINDOW=400
WHALE_PAIR_QUOTE_MAX_REPLACE_PER_WINDOW=400
WHALE_PAIR_QUOTE_MAX_CANCEL_PER_WINDOW=400
WHALE_PAIR_QUOTE_MAX_CHURN_PER_WINDOW=800

# Bonereaper-specific knobs at micro-capital.
WHALE_PAIR_BONEREAPER_CLIP_USD=5
WHALE_PAIR_BONEREAPER_MIN_QTY=5
WHALE_PAIR_BONEREAPER_DEFAULT_TICK=0.01
WHALE_PAIR_BONEREAPER_MAX_CONCURRENT_MARKETS=50

# Live data sources.
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
POLYMARKET_SPOT_SYMBOL=BTCUSDT
POLYMARKET_CLOB_VERSION=v2

# Live deploy gate inputs. The gate reads the shadow process's journal
# and refuses to start strategy entries unless a recent OK verdict is
# present. The shadow process must be running on the same box and
# writing to the path below.
WHALE_PAIR_FIDELITY_GATE_SHADOW_JOURNAL_PATH=/var/lib/polymarket/shadow_live_bonereaper/journal.jsonl
WHALE_PAIR_FIDELITY_GATE_WINDOW_HOURS=24
WHALE_PAIR_FIDELITY_GATE_REQUIRE_OK=true

# Journal output for live. Separate from shadow's journal so the gate
# does not see its own output.
WHALE_PAIR_EXEC_JOURNAL_PATH=/var/lib/polymarket/live_bonereaper/journal.jsonl
WHALE_PAIR_BOOK_SNAPSHOT_LOG_PATH=/var/lib/polymarket/live_bonereaper/book_snapshots.jsonl
WHALE_PAIR_BOOK_SNAPSHOT_MAX_LEVELS=5

WHALE_PAIR_LIVE_KILL_SWITCH_PATH=/var/lib/polymarket/live.kill
