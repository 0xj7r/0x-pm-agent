# Example runtime env for BTC 5m BackToExplore mode.
#
# Copy to ~/.config/polymarket-exec/<sleeve>.env on the host and fill secrets
# there. Do not commit live keys, private keys, or full private RPC URLs.

PM_BTC_5M_EXEC_SERVICE_NAME=polymarket-btc-5m-bte
# BTE runs as an overlay, same pattern as BR2. Keep the native StrategyMode
# empty so no legacy maker strategy runs underneath it.
PM_BTC_5M_STRATEGY=noop
PM_BTC_5M_STRATEGY_PROFILE_PATHS=polymarket-exec/config/strategies/back_to_explore_btc5m.live.yaml
PM_BTC_5M_PAPER_MODE=true
PM_BTC_5M_EXEC_LOAD_DOTENV=false
PM_BTC_5M_EXEC_METRICS_BIND=127.0.0.1:9114

PM_BTC_5M_BTE_SHADOW=true
PM_BTC_5M_BTE_PAPER_TRADE=false
PM_BTC_5M_BTE_LIVE_TRADE=false
# Optional log-only router diagnostics. Enable BR2 shadow too if you want the
# router log to compare BTE votes with BR2 votes. Leave both BR2 arm flags false
# unless deliberately running a separate paper/live BR2 execution test.
# PM_BTC_5M_ROUTER_SHADOW=true
# PM_BTC_5M_BR2_SHADOW=true
# PM_BTC_5M_BR2_PAPER_TRADE=false
# PM_BTC_5M_BR2_LIVE_TRADE=false
# Required only when PM_BTC_5M_BTE_LIVE_TRADE=true and paper mode is false.
# PM_BTC_5M_BTE_MAX_ORDER_NOTIONAL_USD=13.5
# PM_BTC_5M_BTE_MAX_MARKET_NOTIONAL_USD=50
# Live BTE terminal-EV guard is enabled by default. These optional knobs control
# how much guaranteed terminal loss is tolerated before non-improving adds are
# suppressed.
# PM_BTC_5M_BTE_EV_GUARD=true
# PM_BTC_5M_BTE_EV_MAX_GUARANTEED_LOSS_USD=1.0
# PM_BTC_5M_BTE_EV_MIN_WORST_IMPROVEMENT_USD=0.10
# PM_BTC_5M_BTE_EV_MIN_MARGINAL_EV_USD=0.0
# Delay only flat first entries in fast whipsaw/reversal regimes. Existing
# inventory still flows through the repair and EV-accounting path.
# PM_BTC_5M_BTE_WHIPSAW_ENTRY_DELAY_SECS=60

POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_CLOB_VERSION=v2
POLYMARKET_SIGNATURE_TYPE=eoa
# Live mode also requires POLYMARKET_PRIVATE_KEY and CLOB API credentials in
# the host env or private sleeve env file.

# Telonex / Polygon RPC.
# Put the full HTTPS endpoint from Telonex here. Keep the API key out of git.
POLYGON_RPC_URL=https://<your-telonex-polygon-rpc-endpoint>
# POLYGON_RPC_FAILOVER_URLS=https://<backup-polygon-rpc-1>,https://<backup-polygon-rpc-2>

PM_BTC_5M_MARKET_DISCOVERY_ENABLED=true
PM_BTC_5M_MARKET_DISCOVERY_INCLUDE_PREV=0
PM_BTC_5M_MARKET_DISCOVERY_INCLUDE_NEXT=0
PM_BTC_5M_MARKET_DISCOVERY_INTERVAL_MS=30000

PM_BTC_5M_EXEC_SPOT_SYMBOL=BTCUSDT
PM_BTC_5M_EXEC_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
PM_BTC_5M_EXEC_SPOT_REST_BOOTSTRAP_URL=https://api.binance.com/api/v3/aggTrades
PM_BTC_5M_EXEC_COINBASE_SPOT_WS_URL=wss://advanced-trade-ws.coinbase.com

PM_BTC_5M_ORDER_STORE_PATH=data/runtime/btc-5m-bte/order-store.sqlite
PM_BTC_5M_EXEC_JOURNAL_PATH=data/execution/live/btc-5m-bte/journal.jsonl
PM_BTC_5M_EXEC_JOURNAL_FIREHOSE_STREAM=
PM_BTC_5M_EXEC_AUDIT_PATH=data/execution/audit/btc-5m-bte/audit.jsonl

# Live session risk anchors to the first synced venue equity. Starting cash is
# only a paper-mode/pre-sync fallback seed; leave it unset in live sleeves unless
# deliberately testing startup behavior.
# PM_BTC_5M_EXEC_STARTING_CASH_USD=50
# PM_BTC_5M_EXEC_MAX_ORDER_NOTIONAL_USD=18
# PM_BTC_5M_EXEC_MAX_GROSS_NOTIONAL_USD=250
# PM_BTC_5M_EXEC_MAX_NET_NOTIONAL_PER_MARKET_USD=120
# PM_BTC_5M_EXEC_MAX_POSITION_QTY_PER_INSTRUMENT=250
# PM_BTC_5M_EXEC_MIN_FREE_CASH_USD=25
# PM_BTC_5M_EXEC_MIN_FREE_CASH_BPS=500
# PM_BTC_5M_EXEC_MAX_SESSION_LOSS_BPS=2500
# PM_BTC_5M_EXEC_MAX_OPEN_ORDERS_TOTAL=80
# PM_BTC_5M_EXEC_MAX_OPEN_ORDERS_PER_MARKET=32

PM_BTC_5M_LIVE_POST_ONLY=false
PM_BTC_5M_LIVE_ORDER_TTL_MS=20000
PM_BTC_5M_LIVE_ORDER_MAX_AGE_MS=25000
PM_BTC_5M_LIVE_MAX_SUBMIT_ERRORS=1
PM_BTC_5M_LIVE_MAX_CANCEL_ERRORS=3
PM_BTC_5M_LIVE_KILL_ON_RECONCILE_MISMATCH=true
PM_BTC_5M_LIVE_RECONCILE_MISSING_GRACE_MS=5000
PM_BTC_5M_LIVE_PUSD_AUTO_WRAP=true
PM_BTC_5M_LIVE_PUSD_AUTO_WRAP_MIN_USD=0.01

PM_BTC_5M_QUOTE_MIN_ORDER_AGE_MS=5000
PM_BTC_5M_QUOTE_CHURN_WINDOW_MS=20000
PM_BTC_5M_QUOTE_HARD_PULL_MS=5000
PM_BTC_5M_QUOTE_MAX_SUBMIT_PER_WINDOW=60
PM_BTC_5M_QUOTE_MAX_REPLACE_PER_WINDOW=40
PM_BTC_5M_QUOTE_MAX_CANCEL_PER_WINDOW=80
PM_BTC_5M_QUOTE_MAX_CHURN_PER_WINDOW=120

# Optional. Use an absolute host path; shell-style "~" is not expanded by Rust.
# PM_BTC_5M_LIVE_KILL_SWITCH_PATH=/home/YOUR_USER/.config/polymarket-exec/live.kill
