# Example runtime env for BTC 5m tiny-live hybrid mode.
#
# Copy to a private host env file and fill secrets there. Do not commit live
# keys, private keys, or full private RPC URLs.

PM_BTC_5M_EXEC_SERVICE_NAME=polymarket-btc-5m-hybrid-tinylive
PM_BTC_5M_STRATEGY=pair_cost_arb,paired_mm
PM_BTC_5M_STRATEGY_PROFILE_PATHS=polymarket-exec/config/strategies/btc_5m_pair_cost_arb.live.yaml,polymarket-exec/config/strategies/btc_5m_paired_mm.live.yaml
PM_BTC_5M_PAPER_MODE=false
PM_BTC_5M_EXEC_LOAD_DOTENV=false
PM_BTC_5M_EXEC_METRICS_BIND=127.0.0.1:9113

POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_CLOB_VERSION=v2

# Live auth. Fill in private host env only.
POLYMARKET_SIGNATURE_TYPE=eoa
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER_ADDRESS=
# POLYMARKET_PROXY_WALLET_ADDRESS=

# Telonex / Polygon RPC. Put the full HTTPS endpoint from Telonex here.
POLYGON_RPC_URL=https://<your-telonex-polygon-rpc-endpoint>
# POLYGON_RPC_FAILOVER_URLS=https://<backup-polygon-rpc-1>,https://<backup-polygon-rpc-2>

# Dynamic BTC 5m market discovery. The engine does not trade markets missing
# price_to_beat; it stands down and retries on the next discovery tick.
PM_BTC_5M_MARKET_DISCOVERY_ENABLED=true
PM_BTC_5M_MARKET_DISCOVERY_INCLUDE_PREV=0
PM_BTC_5M_MARKET_DISCOVERY_INCLUDE_NEXT=0
PM_BTC_5M_MARKET_DISCOVERY_INTERVAL_MS=30000

PM_BTC_5M_EXEC_SPOT_SYMBOL=BTCUSDT
PM_BTC_5M_EXEC_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
PM_BTC_5M_EXEC_SPOT_REST_BOOTSTRAP_URL=https://api.binance.com/api/v3/aggTrades
PM_BTC_5M_EXEC_COINBASE_SPOT_WS_URL=wss://advanced-trade-ws.coinbase.com

PM_BTC_5M_RUNTIME_RUN_ID=btc-5m-hybrid-tinylive
PM_BTC_5M_ORDER_STORE_PATH=data/runtime/btc-5m-hybrid-tinylive/order-store.sqlite
PM_BTC_5M_EXEC_JOURNAL_PATH=data/execution/live/btc-5m-hybrid-tinylive/journal.jsonl
PM_BTC_5M_EXEC_AUDIT_PATH=data/execution/audit/btc-5m-hybrid-tinylive/audit.jsonl
PM_BTC_5M_SHADOW_QUOTE_LOG_PATH=data/execution/live/btc-5m-hybrid-tinylive/shadow_quotes.jsonl
PM_BTC_5M_BOOK_SNAPSHOT_LOG_PATH=data/execution/live/btc-5m-hybrid-tinylive/book_snapshots.jsonl

PM_BTC_5M_EXEC_LOOP_INTERVAL_MS=1000
PM_BTC_5M_EXEC_SUMMARY_INTERVAL_MS=10000
PM_BTC_5M_ORDER_RECONCILE_INTERVAL_MS=15000
PM_BTC_5M_ORDER_RECONCILE_STALE_MS=30000
PM_BTC_5M_RUNTIME_CHECKPOINT_INTERVAL_MS=30000
PM_BTC_5M_EXEC_BOOK_STALE_MS=2000
PM_BTC_5M_EXEC_PING_INTERVAL_MS=10000

PM_BTC_5M_EXEC_STARTING_CASH_USD=50
PM_BTC_5M_EXEC_MAX_ORDER_NOTIONAL_USD=4
PM_BTC_5M_EXEC_MAX_GROSS_NOTIONAL_USD=10
PM_BTC_5M_EXEC_MAX_NET_NOTIONAL_PER_MARKET_USD=10
PM_BTC_5M_EXEC_MAX_POSITION_QTY_PER_INSTRUMENT=40
PM_BTC_5M_EXEC_MIN_FREE_CASH_USD=25
PM_BTC_5M_EXEC_MIN_FREE_CASH_BPS=2500
PM_BTC_5M_EXEC_MAX_SESSION_LOSS_BPS=2500
PM_BTC_5M_EXEC_MAX_OPEN_ORDERS_TOTAL=16
PM_BTC_5M_EXEC_MAX_OPEN_ORDERS_PER_MARKET=8

PM_BTC_5M_LIVE_POST_ONLY=true
PM_BTC_5M_LIVE_ORDER_TTL_MS=20000
PM_BTC_5M_LIVE_ORDER_MAX_AGE_MS=25000
PM_BTC_5M_LIVE_MAX_SUBMIT_ERRORS=1
PM_BTC_5M_LIVE_MAX_CANCEL_ERRORS=3
PM_BTC_5M_LIVE_KILL_ON_RECONCILE_MISMATCH=true
PM_BTC_5M_LIVE_RECONCILE_MISSING_GRACE_MS=5000
PM_BTC_5M_LIVE_PUSD_AUTO_WRAP=true
PM_BTC_5M_LIVE_PUSD_AUTO_WRAP_MIN_USD=0.01

PM_BTC_5M_QUOTE_MIN_ORDER_AGE_MS=5000
PM_BTC_5M_QUOTE_CHURN_WINDOW_MS=20000
PM_BTC_5M_QUOTE_HARD_PULL_MS=5000
PM_BTC_5M_QUOTE_MAX_SUBMIT_PER_WINDOW=60
PM_BTC_5M_QUOTE_MAX_REPLACE_PER_WINDOW=40
PM_BTC_5M_QUOTE_MAX_CANCEL_PER_WINDOW=80
PM_BTC_5M_QUOTE_MAX_CHURN_PER_WINDOW=120

# Optional operator kill switch. Use an absolute host path.
# PM_BTC_5M_LIVE_KILL_SWITCH_PATH=/home/YOUR_USER/.config/polymarket-exec/live.kill
