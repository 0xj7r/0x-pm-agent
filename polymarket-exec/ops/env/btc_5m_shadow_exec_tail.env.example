# shadow_exec_tail — tails shadow-final JSONL, no belief recompute.
# Keep shadow-final running; never restart it for live.

# File or directory (directory → latest shadow-*.jsonl, rolls at UTC midnight).
PM_SHADOW_JSONL_PATH=/home/ubuntu/data/pm-alpha/shadow/shadow-final

# Persisted byte offset + dedup keys for crash recovery.
PM_SHADOW_TAIL_STATE_PATH=/home/ubuntu/data/pm-alpha/shadow/shadow_exec_tail_state.json

# Paper mode (default ON). Logs LIVE ENTER + SUBMITTED; no venue orders.
# Enable: PAPER_MODE=1  OR  --paper  OR  PM_SHADOW_PAPER_MODE=true
PAPER_MODE=1
# PM_SHADOW_PAPER_TRADE=true   # legacy alias; PAPER_MODE preferred

# Parity gate (would_enter ↔ submit must match within window).
PM_SHADOW_PARITY_WINDOW_S=120
PM_SHADOW_PARITY_STATS_MIN=5
# PM_SHADOW_PARITY_LOG_PATH=/home/ubuntu/data/pm-alpha/shadow/parity_events.jsonl

# Live clip (SSOT shadow logs $50 measure; live caps below).
PM_SHADOW_CLIP_USD=25
PM_SHADOW_MAX_ORDER_NOTIONAL_USD=25
PM_SHADOW_MAX_MARKET_NOTIONAL_USD=50

# Polymarket crypto taker fee curve (per share): fee = 0.07 * p * (1-p).
# At p=0.50 → ~3.5% of notional; at p=0.90 → ~0.63%. Shadow/backtest use
# --fee-curve-rate 0.07. Paper parity audits compare decision stream only;
# fee realization is validated separately via fill-price checks.

# --- Real money (all required; source wallet.env for POLYMARKET_* keys) ---
# PAPER_MODE=0
# PM_SHADOW_LIVE_TRADE=true
# PM_SHADOW_PAPER_MODE=false
# PM_SHADOW_LIVE_KILL_SWITCH_PATH=/home/ubuntu/fade.kill
# rm ~/fade.kill   # disarm kill switch to allow submits
# POLYMARKET_PRIVATE_KEY=...
# POLYMARKET_API_KEY=...
# POLYMARKET_API_SECRET=...
# POLYMARKET_API_PASSPHRASE=...