[Unit]
Description=polymarket-exec live smoke check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/go/polymarket-agent
Environment=WHALE_PAIR_ROOT_DIR=%h/go/polymarket-agent
Environment=WHALE_PAIR_EXEC_MODE=live_smoke
Environment=WHALE_PAIR_PAPER_MODE=false
Environment=WHALE_PAIR_CONTEXT_SOURCE=live
Environment=WHALE_PAIR_INCLUDE_PREV=1
Environment=WHALE_PAIR_INCLUDE_NEXT=1
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=WHALE_PAIR_CARGO_BIN=cargo
Environment=WHALE_PAIR_LIVE_KILL_SWITCH_PATH=%h/.config/polymarket-exec/live.kill
EnvironmentFile=-%h/.config/polymarket-exec/common.env
EnvironmentFile=-%h/.config/polymarket-exec/live.env
ExecStartPre=/usr/bin/env bash -lc 'mkdir -p "${WHALE_PAIR_ROOT_DIR}/data/runtime" "${WHALE_PAIR_ROOT_DIR}/data/execution/live" "$HOME/.config/polymarket-exec"'
ExecStart=/usr/bin/env bash -lc 'cd "${WHALE_PAIR_ROOT_DIR}" && "${WHALE_PAIR_CARGO_BIN:-cargo}" run -p polymarket-exec'
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-exec-live-smoke

[Install]
WantedBy=default.target
