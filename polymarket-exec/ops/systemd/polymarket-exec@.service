[Unit]
Description=polymarket-exec sleeve %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/go/polymarket-agent
Environment=PM_EXEC_ROOT_DIR=%h/go/polymarket-agent
Environment=PM_BTC_5M_CONTEXT_SOURCE=live
Environment=PM_BTC_5M_INCLUDE_PREV=0
Environment=PM_BTC_5M_INCLUDE_NEXT=0
Environment=PM_BTC_5M_CONTEXT_REFRESH_INTERVAL_SEC=45
Environment=PM_BTC_5M_EXEC_LOAD_DOTENV=false
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=PM_PYTHON_BIN=python3
Environment=PM_EXEC_BIN=%h/.local/bin/polymarket-exec
EnvironmentFile=-%h/.config/polymarket-exec/%i.env
ExecStartPre=/usr/bin/env bash -lc 'mkdir -p "${PM_EXEC_ROOT_DIR}/data/runtime" "${PM_EXEC_ROOT_DIR}/data/execution/live" "${PM_EXEC_ROOT_DIR}/data/execution/audit"'
ExecStart=/usr/bin/env bash -lc 'exec "${PM_EXEC_BIN}"'
Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-exec-%i

[Install]
WantedBy=default.target
