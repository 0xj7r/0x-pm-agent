[Unit]
Description=polymarket-exec sleeve %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/go/polymarket-agent
Environment=WHALE_PAIR_ROOT_DIR=%h/go/polymarket-agent
Environment=WHALE_PAIR_CONTEXT_SOURCE=live
Environment=WHALE_PAIR_INCLUDE_PREV=0
Environment=WHALE_PAIR_INCLUDE_NEXT=0
Environment=WHALE_PAIR_CONTEXT_REFRESH_INTERVAL_SEC=45
Environment=WHALE_PAIR_EXEC_LOAD_DOTENV=false
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=WHALE_PAIR_PYTHON_BIN=python3
Environment=WHALE_PAIR_EXEC_BIN=%h/go/polymarket-agent/target/release/polymarket-exec
EnvironmentFile=-%h/.config/polymarket-exec/%i.env
ExecStartPre=/usr/bin/env bash -lc 'mkdir -p "${WHALE_PAIR_ROOT_DIR}/data/runtime" "${WHALE_PAIR_ROOT_DIR}/data/execution/live" "${WHALE_PAIR_ROOT_DIR}/data/execution/audit"'
ExecStart=/usr/bin/env bash -lc 'exec "${WHALE_PAIR_EXEC_BIN}"'
Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-exec-%i

[Install]
WantedBy=default.target
