[Unit]
Description=polymarket-exec sleeve %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/go/polymarket-agent
Environment=WHALE_PAIR_ROOT_DIR=%h/go/polymarket-agent
Environment=WHALE_PAIR_CONTEXT_SOURCE=live
Environment=WHALE_PAIR_INCLUDE_PREV=1
Environment=WHALE_PAIR_INCLUDE_NEXT=1
Environment=WHALE_PAIR_CONTEXT_REFRESH_INTERVAL_SEC=45
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=WHALE_PAIR_PYTHON_BIN=python3
Environment=WHALE_PAIR_CARGO_BIN=cargo
EnvironmentFile=-%h/.config/polymarket-exec/common.env
EnvironmentFile=-%h/.config/polymarket-exec/paper.d/%i.env
ExecStartPre=/usr/bin/env bash -lc 'mkdir -p "${WHALE_PAIR_ROOT_DIR}/data/runtime" "${WHALE_PAIR_ROOT_DIR}/data/execution/paper" "$HOME/.config/polymarket-exec/paper.d"'
ExecStart=/usr/bin/env bash -lc '"${WHALE_PAIR_ROOT_DIR}/polymarket-exec/scripts/run_sleeve.sh" %i'
Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polymarket-exec-%i

[Install]
WantedBy=default.target
