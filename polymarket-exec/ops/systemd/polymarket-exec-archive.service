[Unit]
Description=polymarket-exec paper archive uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/go/polymarket-agent
Environment=WHALE_PAIR_ROOT_DIR=%h/go/polymarket-agent
Environment=WHALE_PAIR_AWS_BIN=aws
EnvironmentFile=-%h/.config/polymarket-exec/common.env
ExecStart=/usr/bin/env bash -lc '$WHALE_PAIR_ROOT_DIR/polymarket-exec/scripts/archive_paper_artifacts.sh'

