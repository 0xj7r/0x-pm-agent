WHALE_PAIR_EXEC_SERVICE_NAME=whale-pair-exec
WHALE_PAIR_STRATEGY=unlawful_shear
WHALE_PAIR_PAPER_MODE=true
RUST_LOG=info
WHALE_PAIR_EXEC_LOG_FORMAT=pretty
WHALE_PAIR_EXEC_METRICS_BIND=0.0.0.0:9108

POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# Comma-separated Polymarket outcome token ids for the BTC 5m market you want to paper.
WHALE_PAIR_ASSET_IDS=

# Optional user market ids for user websocket subscriptions.
WHALE_PAIR_USER_MARKETS=

# Optional market context sidecar generated from the research DB.
WHALE_PAIR_EXEC_MARKET_CONTEXT_PATH=data/research/wallet_research/unlawful-shear/rust_market_context.json

# Optional explicit mapping from token id to market id when the runtime cannot infer market ids.
WHALE_PAIR_INSTRUMENT_MARKETS=

WHALE_PAIR_EXEC_LOOP_INTERVAL_MS=1000
WHALE_PAIR_EXEC_SUMMARY_INTERVAL_MS=10000
WHALE_PAIR_EXEC_BOOK_STALE_MS=2000
WHALE_PAIR_EXEC_PING_INTERVAL_MS=10000
WHALE_PAIR_EXEC_STARTING_CASH_USD=100.0
WHALE_PAIR_EXEC_EVENT_LOG_CAPACITY=4096
WHALE_PAIR_EXEC_JOURNAL_PATH=data/execution/paper/unlawful_shear_journal.jsonl

WHALE_PAIR_EXEC_MAX_ORDER_NOTIONAL_USD=40.0
WHALE_PAIR_EXEC_MAX_GROSS_NOTIONAL_USD=150.0
WHALE_PAIR_EXEC_MAX_NET_NOTIONAL_PER_MARKET_USD=120.0
WHALE_PAIR_EXEC_MAX_POSITION_QTY_PER_INSTRUMENT=1000.0
WHALE_PAIR_EXEC_MIN_FREE_CASH_USD=5.0
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_TOTAL=16
WHALE_PAIR_EXEC_MAX_OPEN_ORDERS_PER_MARKET=8

WHALE_PAIR_UNLAWFUL_SHEAR_CHEAP_HEDGE_PRICE_MAX=0.38
WHALE_PAIR_UNLAWFUL_SHEAR_CORE_PRICE_MIN=0.52
WHALE_PAIR_UNLAWFUL_SHEAR_CORE_PRICE_MAX=0.92
WHALE_PAIR_UNLAWFUL_SHEAR_MIN_PRICE_GAP=0.12
WHALE_PAIR_UNLAWFUL_SHEAR_PROBE_CLIP_USD=12.0
WHALE_PAIR_UNLAWFUL_SHEAR_CORE_CLIP_USD=35.0
WHALE_PAIR_UNLAWFUL_SHEAR_HEDGE_CLIP_USD=16.0
WHALE_PAIR_UNLAWFUL_SHEAR_REBALANCE_CLIP_USD=20.0
WHALE_PAIR_UNLAWFUL_SHEAR_TRIM_CLIP_FRACTION=0.30
WHALE_PAIR_UNLAWFUL_SHEAR_MAX_GROSS_COST_USD=120.0
WHALE_PAIR_UNLAWFUL_SHEAR_TARGET_HEDGE_RATIO_MIN=0.20
WHALE_PAIR_UNLAWFUL_SHEAR_TARGET_HEDGE_RATIO_MAX=0.60
WHALE_PAIR_UNLAWFUL_SHEAR_SALVAGE_DRAWDOWN_RATIO=0.18
WHALE_PAIR_UNLAWFUL_SHEAR_SALVAGE_BID_FLOOR=0.05
WHALE_PAIR_UNLAWFUL_SHEAR_MAX_OPEN_ORDERS_TOTAL=6
WHALE_PAIR_UNLAWFUL_SHEAR_COOLDOWN_MS=400
