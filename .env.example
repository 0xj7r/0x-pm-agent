# Polymarket
POLYMARKET_PRIVATE_KEY=your_ethereum_private_key_here
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Polymarket signature type + funder (proxy wallet) config.
#
# Which signature type to use depends on how your Polymarket account was
# created. The signer is always the EOA controlled by POLYMARKET_PRIVATE_KEY;
# the funder is the address that actually HOLDS the USDC collateral.
#
# - Polymarket.com email-login users (most common): the app creates a
#   POLY_PROXY contract that holds your USDC. Set:
#     POLYMARKET_SIGNATURE_TYPE=1
#     POLYMARKET_FUNDER=<proxy address shown in the Polymarket app>
#
# - Polymarket.com web login (non-email / wallet-connected): usually a
#   Gnosis Safe. Set:
#     POLYMARKET_SIGNATURE_TYPE=2
#     POLYMARKET_FUNDER=<proxy/safe address>
#
# - Metamask-direct EOA (USDC held directly by the signer EOA): leave
#   BOTH unset. The library default is EOA (signature_type=0) with
#   funder=signer_address.
#
# Allowed values for POLYMARKET_SIGNATURE_TYPE: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
POLYMARKET_SIGNATURE_TYPE=
POLYMARKET_FUNDER=

# Claude API (agent pays for its own inference from profits)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-5-20250514

# Risk parameters
MAX_POSITION_PCT=0.06
MIN_EDGE_THRESHOLD=0.15
KILL_BALANCE_USD=5.0
SCAN_INTERVAL_SECONDS=120

# Exit logic: sell when fair value exceeds this threshold
EXIT_THRESHOLD=0.45

# Max USD per single position
MAX_POSITION_USD=2.0

# Daily loss limit as fraction of bankroll (stop trading if exceeded)
DAILY_LOSS_LIMIT_PCT=0.20

# Max number of open positions at once
MAX_CONCURRENT_POSITIONS=10

# Cooldown after consecutive losses: pause after N losses for M seconds
LOSS_COOLDOWN_TRADES=3
LOSS_COOLDOWN_SECONDS=1800

# Strategy toggles
ENABLE_WEATHER=true
ENABLE_ARBITRAGE=true
ENABLE_COPY_TRADING=true
ENABLE_TREND_DETECTION=true

# Weather strategy
WEATHER_CITIES=New York,Los Angeles,Chicago,Houston,Phoenix,Philadelphia,San Antonio,San Diego,Dallas,Austin,Miami,Denver,Seattle,Boston,Nashville,Portland,Las Vegas,Atlanta,Minneapolis,Detroit

# Paper trading mode
PAPER_TRADE=true
PAPER_STARTING_BALANCE=100.0

# Canonical strategy config selection
STRATEGY_CONFIG=/app/strategy_config.json
STRATEGY_PROFILE=default

# Copy trading: comma-separated wallet addresses to track (optional)
# If empty, the agent attempts auto-discovery from the leaderboard API
COPY_TRADING_WALLETS=

# Paper trading starting balance (USD)
PAPER_STARTING_BALANCE=100.0

# Copy trading: comma-separated wallet addresses to track (empty = auto-discover)
COPY_TRADING_WALLETS=

# Persistence
DB_PATH=trades.db
MEMORY_PATH=
SUPABASE_URL=
SUPABASE_KEY=

# Logging
LOG_LEVEL=INFO
