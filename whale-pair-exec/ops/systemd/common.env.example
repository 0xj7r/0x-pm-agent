# Common host-level overrides for always-on unlawful paper services.
# Copy to: ~/.config/whale-pair-exec/common.env

# Repo checkout on the always-on host.
# Leave unset unless you need to override the systemd unit default.
# If you do override it, use an absolute path; EnvironmentFile values do not
# expand shell variables like $HOME.
# WHALE_PAIR_ROOT_DIR=/root/go/polymarket-agent

# Runtime export source for rolling BTC 5m slate selection.
WHALE_PAIR_CONTEXT_SOURCE=live
WHALE_PAIR_INCLUDE_PREV=1
WHALE_PAIR_INCLUDE_NEXT=1
WHALE_PAIR_CONTEXT_REFRESH_INTERVAL_SEC=45

# Host toolchain paths if cargo/python are not on the default PATH in systemd.
WHALE_PAIR_PYTHON_BIN=python3
WHALE_PAIR_CARGO_BIN=cargo
WHALE_PAIR_AWS_BIN=aws

# Paper uses live market + BTC feeds but does not require Polymarket auth.
WHALE_PAIR_EXEC_SPOT_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade
WHALE_PAIR_EXEC_SPOT_SYMBOL=BTCUSDT
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# Tiny-live only. Leave unset for paper.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

RUST_LOG=info
RUST_BACKTRACE=1

# Microstructure controller. These only reduce/block new buys; cleanup/reduce-only
# exits are not blocked by these settings.
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_ENABLED=true
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_REQUIRE_DEPTH=false
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_MAX_SPREAD=0.05
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_MIN_ASK_NOTIONAL_TOP3_USD=2
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_MAX_CLIP_ASK_NOTIONAL_FRACTION=0.10
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_IMBALANCE_THRESHOLD=0.55
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_WEAK_BID_SCALE=0.65
WHALE_PAIR_UNLAWFUL_SHEAR_MICROSTRUCTURE_THIN_ASK_SCALE=0.85

# Keep active journals bounded by rotating them into timestamped segments.
# 268435456 bytes = 256 MiB
WHALE_PAIR_EXEC_JOURNAL_ROTATE_BYTES=268435456

# Cheap archive path for old paper artifacts. Leave S3 URI unset to disable.
# Recommended storage class for cold paper logs is DEEP_ARCHIVE.
# WHALE_PAIR_ARCHIVE_S3_URI=s3://your-bucket/polymarket-agent
WHALE_PAIR_ARCHIVE_STORAGE_CLASS=DEEP_ARCHIVE
WHALE_PAIR_ARCHIVE_MIN_AGE_MINUTES=30
WHALE_PAIR_ARCHIVE_DELETE_LOCAL_AFTER_UPLOAD=false
WHALE_PAIR_ARCHIVE_INCLUDE_PRE_FIX=true
WHALE_PAIR_ARCHIVE_INCLUDE_RUNTIME_PRE_FIX=true
WHALE_PAIR_ARCHIVE_INCLUDE_ROTATED_SEGMENTS=true
WHALE_PAIR_ARCHIVE_ACTIVE_JOURNAL_WARN_BYTES=1073741824
# Set true for a cheap local candidate listing without touching AWS.
WHALE_PAIR_ARCHIVE_LIST_ONLY=false
WHALE_PAIR_ARCHIVE_DRY_RUN=false
