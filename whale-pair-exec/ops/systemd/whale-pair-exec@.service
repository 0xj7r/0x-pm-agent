[Unit]
Description=whale-pair-exec sleeve %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/go/polymarket-agent
Environment=WHALE_PAIR_ROOT_DIR=%h/go/polymarket-agent
Environment=WHALE_PAIR_CONTEXT_SOURCE=live
Environment=WHALE_PAIR_INCLUDE_PREV=1
Environment=WHALE_PAIR_INCLUDE_NEXT=1
ExecStart=/usr/bin/env bash -lc '$WHALE_PAIR_ROOT_DIR/whale-pair-exec/scripts/run_sleeve.sh %i'
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=default.target
